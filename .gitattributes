# Workstation checkouts must preserve executable shell syntax on every host.
*.sh text eol=lf
*.ksh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.java text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.diff text eol=lf
*.md whitespace=-blank-at-eol
tools/source-overlays/*.diff whitespace=-blank-at-eol
*.png binary
